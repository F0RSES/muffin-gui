/* ============================================================================
   Muffin — light theme. Same selector tree as theme_dark.qss, light tokens.

   Tokens (mirrored by Theme.cpp::tokensFor(false) — change both, they are one palette):
     bg #F3F4F6   rail #E5E7EB   surface #FFFFFF   recessed #F9FAFB
     hairline #D1D5DB   control border #9CA3AF   text #1F2937   muted #6B7280   quiet text #4B5563
     log text #111827 (Theme::logColor(0))   ring mark #111827 (Theme::markOnRing())
     accent #7C3AED (hover #8B5CF6, pressed #6D28D9, soft fill #EDE9FE, selected fill #F3E8FF, soft edge #DDD6FE)
     accent2 #0891B2   ok #059669   err #DC2626   warn #D97706
     the live green #10B981 and the badge grey #9CA3AF are painted tokens shared with the dark sheet

   Deliberately not black-on-white: the canvas is a soft grey-white, surfaces are white behind a grey
   hairline so they read as raised, and the darkest text is #1F2937 — eyes on this screen all day.
   ==========================================================================*/
/* Dialogs keep an opaque rectangle; the main window must not paint one. Same reasoning as the dark sheet:
   it is frameless and WA_TranslucentBackground, so a background here is a light grey square over the whole
   surface, corners included, hiding the rounded silhouette #mainWindowFrame draws inside it. */
QDialog { background-color: #F3F4F6; }
QMainWindow#mainWindow { background-color: transparent; }

QWidget {
    background-color: transparent;
    color: #1F2937;
    font-family: "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 10pt;
}
QToolTip {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #D1D5DB; padding: 5px 8px; border-radius: 6px;
}

/* ---------- tool buttons ---------- */
/* The main window has no toolbar; these survive for the tool buttons a native dialog can show. */
QToolBar, QToolBar::separator { background-color: #E5E7EB; border: none; spacing: 6px; }
QToolButton {
    background-color: transparent; color: #1F2937;
    border: 1px solid transparent; border-radius: 8px; padding: 6px 10px;
}
QToolButton:hover  { background-color: #E5E7EB; border-color: #9CA3AF; }
QToolButton:pressed { background-color: #D1D5DB; }
QToolButton:disabled { color: #A7ABBB; }

/* ---------- shell: the window's own silhouette ---------------------------------
   The window paints nothing (QMainWindow#mainWindow above), so this card is the shape: the same 12 px arc,
   1 px stroke in the sheet's hairline and 2 px of transparent band as the dark sheet declares, all three
   read off MainWindow::kWindowFrameRadiusPx / kWindowFrameBorderPx / kWindowFrameMarginPx by the tests.
   The corner list is in that sheet's shell block; the arithmetic is the same here — the surfaces that
   reach a window corner carry 12 - 1 = 11 px.

   The light theme is the one that proves it. In the dark sheet the rail, the header band and the footer are
   all #0B0C10, the same as the shell's own fill, so a square corner there is invisible in the pixels and
   only the broken stroke gives it away; here the rail is #E5E7EB against a #F3F4F6 shell, so an unrounded
   corner is a grey nub sitting outside the arc on the desktop. Checked corner by corner, in both themes, in
   tests/uitest.cpp. */
QFrame#mainWindowFrame {
    background-color: #F3F4F6;
    border: 1px solid #D1D5DB;
    border-radius: 12px;
}

/* ---------- shell: rail + main area -------------------------------------------
   The same 70 px rail of glyphs as the dark sheet, in daylight tokens. */
QFrame#sidebar {
    background-color: #E5E7EB;
    border-right: 1px solid #D1D5DB;
    border-top-left-radius: 11px;
    border-bottom-left-radius: 11px;
}
QFrame#mainArea {
    background-color: #F3F4F6;
    border-top-right-radius: 11px;
    border-bottom-right-radius: 11px;
}
QLabel#brandLogo { background-color: transparent; }

/* One rounded plate for every rail glyph — hover, press, and the page currently on screen. Journal and
   settings share it (and the language button below shares its shape), so no single control looks like the
   only one that answers the pointer. */
QPushButton#navButton {
    background-color: transparent; color: #6B7280;
    border: 1px solid transparent; border-radius: 8px; padding: 0;
}
QPushButton#navButton:hover { background-color: #E5E7EB; border-color: #D1D5DB; color: #1F2937; }
QPushButton#navButton:pressed { background-color: #D1D5DB; border-color: #D1D5DB; }
QPushButton#navButton:checked { background-color: #EDE9FE; border-color: #DDD6FE; color: #7C3AED; }
QPushButton#navButton:focus { outline: none; border-color: #DDD6FE; }
QPushButton#navButton:disabled { color: #9CA3AF; background-color: transparent; }
QPushButton#navButton[alert="true"] { color: #DC2626; border-color: #FCA5A5; background-color: #FEF2F2; }

/* The rail's one QToolButton: a flag, not a glyph, so it is deliberately not tinted by the sheet. */
QToolButton#langButton {
    background-color: transparent; border: 1px solid transparent; border-radius: 8px; padding: 0;
}
QToolButton#langButton:hover { background-color: #E5E7EB; border-color: #D1D5DB; }
QToolButton#langButton:pressed { background-color: #D1D5DB; }
QToolButton#langButton:focus { outline: none; border-color: #DDD6FE; }

QLabel#railVersion {
    background-color: transparent;
    color: #4B5563; font-size: 8pt; font-weight: 500; letter-spacing: 0.3px;
}

/* ---------- window chrome (frameless) ----------------------------------------
   Same pair as the dark sheet. Icon-only QToolButtons in the header, each carrying a "glyph" property so
   applyTheme() re-bakes it; the close control is tinted to the light theme's red on hover so leaving reads
   apart from minimising. */
QToolButton#windowButton {
    background-color: transparent; color: #6B7280;
    border: 1px solid transparent; border-radius: 8px; padding: 0;
}
QToolButton#windowButton:hover { background-color: #E5E7EB; border-color: #D1D5DB; color: #1F2937; }
QToolButton#windowButton:pressed { background-color: #D1D5DB; }
QToolButton#windowButton:focus { outline: none; border-color: #DDD6FE; }
QToolButton#windowButton[role="close"]:hover { background-color: #DC2626; border-color: #DC2626; color: #FFFFFF; }
QToolButton#windowButton[role="close"]:pressed { background-color: #B91C1C; border-color: #B91C1C; }
/* The release badge, and the same note as the dark sheet: its colour is baked into the glyph by
   applyTheme() (the light sheet's accent2, #0891B2 — cyan that works on a white page), and what the sheet
   owns is the plate it lands on. */
QToolButton#windowButton[role="update"] { border-color: transparent; }
QToolButton#windowButton[role="update"]:hover { background-color: #ECFEFF; border-color: #0891B2; }
QToolButton#windowButton[role="update"]:pressed { background-color: #CFFAFE; border-color: #0891B2; }

/* ---------- header ---------- */
/* The band is the top of the main column, so it is also the window's top-right corner: 11 px, the shell's
   arc minus its stroke (see the shell block). */
QWidget#headerBar { background-color: #F3F4F6; border-top-right-radius: 11px; }
QLabel#appTitle {
    background-color: transparent;
    font-family: "Montserrat", "Outfit", "Segoe UI", "Inter", sans-serif;
    font-weight: 800; font-size: 18pt; letter-spacing: 0.5px; color: #7C3AED;
}
QFrame#headerRule { background-color: #D1D5DB; border: none; }

/* The green here is Theme::pingOk() — #10B981 in both themes, because the ping rings and the power ring
   are painted from that one token and cannot follow a per-theme sheet colour. */
QWidget#statusDot { background-color: #10B981; border-radius: 3px; }
QWidget#statusDot[statusKind="stopped"]  { background-color: #9CA3AF; }
QWidget#statusDot[statusKind="starting"] { background-color: #D97706; }
QWidget#statusDot[statusKind="running"]  { background-color: #10B981; }
QWidget#statusDot[statusKind="error"]    { background-color: #DC2626; }
QLabel#statusText {
    background-color: transparent;
    color: #10B981; font-size: 9pt; font-weight: 600; letter-spacing: 1px;
}
QLabel#statusText[statusKind="stopped"]  { color: #6B7280; }
QLabel#statusText[statusKind="starting"] { color: #D97706; }
QLabel#statusText[statusKind="running"]  { color: #059669; }
QLabel#statusText[statusKind="error"]    { color: #DC2626; }

QPushButton#ghostButton {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #9CA3AF; border-radius: 10px;
    padding: 6px 12px; font-size: 10pt; font-weight: 500;
}
QPushButton#ghostButton:hover { background-color: #F9FAFB; border-color: #7C3AED; color: #1F2937; }
QPushButton#ghostButton:pressed { background-color: #E5E7EB; }
QPushButton#ghostButton:focus { outline: none; border-color: #7C3AED; }
QPushButton#ghostButton:disabled { color: #9CA3AF; background-color: #E5E7EB; border-color: #E5E7EB; }

/* ---------- pages ---------- */
QStackedWidget#pageStack { background-color: #F3F4F6; }
QWidget#dashboardPage, QWidget#profilesPage, QWidget#logsPage { background-color: #F3F4F6; }
QWidget#settingsPageHost, QWidget#settingsPage { background-color: #F3F4F6; }
QLabel#pageTitle {
    background-color: transparent;
    font-size: 15pt; font-weight: 700; color: #1F2937;
}

/* ---------- profile rows ----------
    One horizontal row per profile: the name at the left, the mini ping chips in the middle, the row menu
    at the right. A row is a choice, not a control — starting belongs to the dashboard's power button — so
    the only interactive states are the two the window paints with dynamic properties: the accent edge says
    "this is the profile the button will run", the red edge says "this one failed" and moves the reason to
    the tooltip. Because QSS never re-reads a property on its own, ProfileCard unpolishes/repolishes on
    every change, exactly as the rail's [alert] tab does. */
QFrame#profileCard {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 12px;
}
QFrame#profileCard:hover { background-color: #F9FAFB; border-color: #9CA3AF; }
QFrame#profileCard[selected="true"] {
    border: 2px solid #7C3AED;
    background-color: #F3E8FF;
}
QFrame#profileCard[selected="true"]:hover { background-color: #EDE9FE; border-color: #7C3AED; }
QFrame#profileCard[error="true"] {
    border: 2px solid #DC2626;
    background-color: #FDF2F2;
}
QLabel#profileName {
    background-color: transparent; color: #1F2937; font-size: 11pt; font-weight: 600;
}
QWidget#profilePings { background-color: transparent; border: none; }
/* A chip is one service's mark inside its ring, and its latency beside them, on a faint recessed plate
   so the pair reads as a unit rather than as two loose labels. The ring's colour is the verdict:
   ProfileCard stamps [pingStatus] from the same mapping PingIndicator::dotColor() paints the dashboard's
   rings with — the live green is theme-independent, the amber and the red are this sheet's own. The halo
   is a QGraphicsDropShadowEffect in C++ (QSS has no box-shadow) and the row reserves its room. */
QWidget#miniPing {
    background-color: #F9FAFB; border: 2px solid #D1D5DB; border-radius: 11px;
}
QWidget#miniPing[pingStatus="ok"]      { border-color: #10B981; }
QWidget#miniPing[pingStatus="waiting"] { border-color: #D97706; }
QWidget#miniPing[pingStatus="fail"]    { border-color: #DC2626; }
QLabel#miniPingIcon { background-color: transparent; }
QLabel#miniPingValue {
    background-color: transparent; color: #4B5563;
}
QLabel#muted     { color: #4B5563; }
QLabel#placeholder { color: #6B7280; font-size: 11pt; }

/* The row's menu button: a 30x30 plate holding the three-dot glyph, quiet until the pointer arrives. */
QToolButton#cardMenu {
    background-color: transparent; border: 1px solid transparent; border-radius: 8px; padding: 0;
}
QToolButton#cardMenu:hover { background-color: #E5E7EB; border-color: #D1D5DB; }
QToolButton#cardMenu:pressed { background-color: #D1D5DB; }
QToolButton#cardMenu:focus { outline: none; }
/* Three dots and nothing else: the handle pops its menu on press (InstantPopup in code), so the style's
   down-arrow is a second affordance on a control that has just opened its menu, and in a 30x30 plate it
   pushes the dots off centre. */
QToolButton#cardMenu::menu-indicator { image: none; width: 0px; }
QMenu#cardMenuPopup { min-width: 148px; }

QPushButton {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #9CA3AF; border-radius: 8px; padding: 7px 14px;
}
QPushButton:hover   { background-color: #F9FAFB; border-color: #9CA3AF; }
QPushButton:pressed { background-color: #E5E7EB; }
QPushButton:disabled { color: #9CA3AF; background-color: #E5E7EB; border-color: #E5E7EB; }
QPushButton#primaryButton {
    background-color: #7C3AED; color: #FFFFFF; border: 1px solid #7C3AED;
    border-radius: 8px; padding: 8px 16px; font-weight: 600;
}
QPushButton#primaryButton:hover   { background-color: #8B5CF6; border-color: #8B5CF6; }
QPushButton#primaryButton:pressed { background-color: #6D28D9; }
QPushButton#primaryButton:disabled { background-color: #DDD6FE; border-color: #DDD6FE; color: #F5F3FF; }
QPushButton#dangerButton { background-color: #FEE2E2; border-color: #FCA5A5; color: #B91C1C; }
QPushButton#dangerButton:hover { background-color: #FECACA; }
/* An id selector outranks a pseudo-state in QSS specificity, so QPushButton:disabled above does NOT
   reach this button: without this rule a greyed-out "Остановить" keeps its full live red and reads as
   clickable, which is precisely the misleading state during a teardown. Keep the neutral disabled
   tokens so it looks like every other unavailable control. */
QPushButton#dangerButton:disabled { background-color: #E5E7EB; border-color: #E5E7EB; color: #9CA3AF; }

QLineEdit, QSpinBox, QComboBox {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #9CA3AF; border-radius: 8px; padding: 6px 10px;
    selection-background-color: #7C3AED; selection-color: #FFFFFF;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #7C3AED; }
QLineEdit:read-only { color: #6B7280; background-color: #F9FAFB; }
QLineEdit#pathOk   { border: 1px solid #059669; }
QLineEdit#pathBad  { border: 1px solid #DC2626; }
QLabel#validOk  { color: #059669; font-size: 9pt; }
QLabel#validBad { color: #DC2626; font-size: 9pt; }
QLabel#trayNote { color: #B45309; font-size: 8pt; }
/* The Save button's acknowledgement — green, because it reports an outcome rather than an action, and it
   sits beside the primary button without competing with it for attention. */
QLabel#savedNote { color: #059669; font-size: 10pt; font-weight: 600; background: transparent; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right;
    width: 22px; border: none; }
QComboBox::down-arrow { image: url(:/icons/arrow-down.svg); width: 14px; height: 14px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #9CA3AF; border-radius: 8px; padding: 4px;
    selection-background-color: #7C3AED; selection-color: #FFFFFF; outline: none;
}
/* The app's only spin box is the ping interval, and it hides its buttons in code; these rules close the
   gutter those arrows would have claimed so a hidden control leaves no dead width behind it. */
QSpinBox::up-button, QSpinBox::down-button { width: 0px; border: none; background: transparent; }
QSpinBox::up-arrow, QSpinBox::down-arrow { image: none; width: 0px; height: 0px; }

QCheckBox { spacing: 8px; color: #1F2937; background: transparent; }
QCheckBox::indicator {
    width: 16px; height: 16px; border-radius: 5px;
    border: 1px solid #9CA3AF; background-color: #FFFFFF;
}
QCheckBox::indicator:hover  { border-color: #7C3AED; }
QCheckBox::indicator:checked { background-color: #7C3AED; border-color: #7C3AED;
    image: url(:/icons/check.svg); }

QPlainTextEdit#logView {
    background-color: #FFFFFF; color: #111827;
    border: 1px solid #9CA3AF; border-radius: 10px;
    font-family: "JetBrains Mono", "Cascadia Mono", "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 9pt; padding: 6px;
}
QFrame#logPanel { background-color: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 12px; }
QFrame#logHeader { background: transparent; border: none; }

/* ---------- history and statistics page ----------
   Same three-colour vocabulary as the dark sheet: the row is green, amber or red before it is a word.
   The light canvas needs the state colours darkened to their sheet values (#059669/#D97706/#DC2626) and
   a much fainter tint than the dark one — the same alpha that reads as a wash on #0B0C10 reads as a
   sticker on white. The tint itself is applied in C++ from Theme::, so only the panel and table colours
   live here.

   The row's colour is model data and the delegate paints it: this sheet's ::item rule moves item
   painting into the stylesheet style, which then paints only what the rule declares. What the sheet must
   not do is declare a background or a colour for `::item` — that would outrank the verdict and flatten
   the colour coding. */
QWidget#historyPage { background-color: #F3F4F6; }
QFrame#historySummary {
    background-color: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 12px;
}
QLabel#historyHeadline {
    background-color: transparent; color: #1F2937; font-size: 16pt; font-weight: 700;
}
QProgressBar#historyRateBar {
    border: none; border-radius: 4px; background-color: #F9FAFB;
    min-height: 8px; max-height: 8px;
}
/* The band is a dynamic property stamped by HistoryPage::setRateLevel(), which re-polishes the widget
   because QSS never re-reads a property on its own. "none" is the empty history: a grey thread, because
   an untouched record has not earned a verdict. */
QProgressBar#historyRateBar[rateLevel="good"]::chunk { background-color: #059669; border-radius: 4px; }
QProgressBar#historyRateBar[rateLevel="fair"]::chunk { background-color: #D97706; border-radius: 4px; }
QProgressBar#historyRateBar[rateLevel="poor"]::chunk { background-color: #DC2626; border-radius: 4px; }
QProgressBar#historyRateBar[rateLevel="none"]::chunk { background-color: #D1D5DB; border-radius: 4px; }
/* The panel owns the rounded box and the table inside it paints nothing — the same shape the dark sheet
   explains at length: a QTableView's radius rounds only its FRAME, while the header band and the rows
   are children that keep square corners and paint over the arc. The inset settles it, not a clip. */
QFrame#historyTableCard {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB; border-radius: 12px;
}
/* The table is the panel's fill, not transparent — see the dark sheet for why. */
QTableView#historyTable {
    background-color: #FFFFFF;
    border: none;
    gridline-color: #E5E7EB;
    selection-background-color: #EDE9FE; selection-color: #1F2937;
    outline: none;
}
QTableView#historyTable::item { padding: 2px 10px; border: none; }
QHeaderView#historyHeader::section {
    background-color: #F3F4F6; color: #4B5563; border: none;
    border-bottom: 1px solid #D1D5DB; padding: 7px 10px; font-weight: 600;
}
QHeaderView#historyHeader::section:hover { color: #1F2937; }
QHeaderView#historyHeader::up-arrow { image: none; width: 0px; height: 0px; }
QHeaderView#historyHeader::down-arrow { image: none; width: 0px; height: 0px; }
QWidget#historyEmpty { background-color: transparent; }
QLabel#historyEmptyGlyph { background-color: transparent; }
/* The three counts, on the light canvas: the sheet's own quiet grey plate, and the two state colours at
   their light-sheet values (#DC2626/#D97706 — Theme::error()/Theme::warning() here) with white ink,
   which is the same pair the rate bar's chunk and the failing rows use. A chip's band is stamped in C++. */
QLabel#historyBadge {
    background-color: #F3F4F6; color: #4B5563;
    border-radius: 9px; padding: 3px 10px; font-weight: 600;
}
QLabel#historyBadge[badgeKind="danger"]  { background-color: #DC2626; color: #FFFFFF; }
QLabel#historyBadge[badgeKind="warning"] { background-color: #D97706; color: #FFFFFF; }

QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #D1D5DB; border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #9CA3AF; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal { background: #D1D5DB; border-radius: 4px; min-width: 28px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: none; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---------- footer + ping badges ---------- */
/* Its bottom-right corner is the window's own, hence the radius the shell block above explains. */
QFrame#footerBar { background-color: #F3F4F6; border-top: 1px solid #D1D5DB; border-bottom-right-radius: 11px; }
QLabel#footerHint { background-color: transparent; color: #4B5563; font-size: 8pt; }
QLabel#pingNumber { background-color: transparent; color: #1F2937; }
QLabel#pingClock  { background-color: transparent; }
QLabel#pingLabel  { background-color: transparent; color: #4B5563; font-size: 8pt; }

QMenu {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #9CA3AF; border-radius: 10px; padding: 6px;
}
QMenu::item { padding: 6px 22px 6px 14px; border-radius: 6px; }
QMenu::item:selected { background-color: #7C3AED; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #E5E7EB; margin: 5px 8px; }

QSplitter::handle { background-color: #E5E7EB; width: 3px; }
QGroupBox { border: 1px solid #D1D5DB; border-radius: 10px; margin-top: 12px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; color: #6B7280; }
QHeaderView::section { background-color: #E5E7EB; color: #6B7280; border: none; padding: 6px; }
QDialogButtonBox QPushButton { min-width: 84px; }
QProgressBar { border: 1px solid #D1D5DB; border-radius: 6px; background: #F9FAFB; color: #1F2937; }
QProgressBar::chunk { background-color: #0891B2; border-radius: 5px; }

/* The profiles page's bypass-check meter: a 6 px thread under the page head, not the download's
   bar — it reports one button press. Geometry only; the colours come from the rules above. */
QProgressBar#blockcheckProgress { min-height: 6px; max-height: 6px; border-radius: 3px; }
QProgressBar#blockcheckProgress::chunk { border-radius: 2px; }

/* ---------- window surfaces (keep this block last) ---------------------------
   Same cascade trap as the dark sheet: the generic transparent QWidget rule outranks the window rule at
   the top of the file, so anything with nothing behind it (the stacked widget, the card list's viewport)
   painted black instead of the light background.

   TWO surfaces are deliberately left out and stay transparent — the window and the canvas it holds —
   because together they are the band around #mainWindowFrame. Fill either one on this sheet and the
   rounded card is a rounding behind an opaque light square: glaring here, where the dark sheet at least
   hides the mistake in matching colour. */
QDialog, QStackedWidget, QStackedWidget#pageStack, QSplitter, QScrollArea,
QScrollArea > QWidget > QWidget, QWidget#cardHost, QWidget#logPanel,
QWidget#logHeader, QWidget#dashboardPage, QWidget#profilesPage, QWidget#logsPage,
QWidget#placeholderPage, QWidget#settingsPageHost, QWidget#settingsPage, QWidget#historyPage,
QWidget#headerBar {
    background-color: #F3F4F6;
}
QMainWindow#mainWindow, QWidget#rootCanvas { background-color: transparent; }
QFrame#mainWindowFrame {
    background-color: #F3F4F6;
    border: 1px solid #D1D5DB;
    border-radius: 12px;
}
QFrame#sidebar { background-color: #E5E7EB; }
QFrame#mainArea, QFrame#footerBar { background-color: #F3F4F6; }
