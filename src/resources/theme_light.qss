/* ============================================================================
   Muffin — light theme. Same selector tree as theme_dark.qss, light tokens.
   ==========================================================================*/
QMainWindow, QDialog { background-color: #F4F5FA; }

QWidget {
    background-color: transparent;
    color: #1F2937;
    font-family: "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 10pt;
}
QToolTip {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #D6D8E4; padding: 5px 8px; border-radius: 6px;
}

/* ---------- tool buttons ---------- */
/* The main window has no toolbar; these survive for the tool buttons a native dialog can show. */
QToolBar, QToolBar::separator { background-color: #E9EBF3; border: none; spacing: 6px; }
QToolButton {
    background-color: transparent; color: #404655;
    border: 1px solid transparent; border-radius: 8px; padding: 6px 10px;
}
QToolButton:hover  { background-color: #DCDFEB; border-color: #C9CCDC; }
QToolButton:pressed { background-color: #CDD1E0; }
QToolButton:disabled { color: #A7ABBB; }

/* ---------- shell: rail + main area -------------------------------------------
   The same 70 px rail of glyphs as the dark sheet, in daylight tokens. */
QFrame#sidebar {
    background-color: #E9EBF3;
    border-right: 1px solid #DCDEEA;
}
QFrame#mainArea { background-color: #F4F5FA; }
QLabel#brandLogo { background-color: transparent; }

QPushButton#navButton {
    background-color: transparent; color: #6B7280;
    border: 1px solid transparent; border-radius: 12px; padding: 0;
}
QPushButton#navButton:hover { background-color: #DCDFEB; border-color: #D0D4E3; color: #1F2937; }
QPushButton#navButton:pressed { background-color: #D0D4E3; }
QPushButton#navButton:checked { background-color: #F4EFFF; border-color: #DDD0F5; color: #7C3AED; }
QPushButton#navButton:focus { outline: none; border-color: #DDD0F5; }
QPushButton#navButton:disabled { color: #B4B8C6; background-color: transparent; }
QPushButton#navButton[alert="true"] { color: #DC2626; border-color: #FCA5A5; background-color: #FEF2F2; }

QLabel#railVersion {
    background-color: transparent;
    color: #9CA3AF; font-size: 10px; font-weight: 500; letter-spacing: 0.3px;
}

/* ---------- header ---------- */
QWidget#headerBar { background-color: #F4F5FA; }
QLabel#appTitle {
    background-color: transparent;
    font-family: "Montserrat", "Outfit", "Segoe UI", "Inter", sans-serif;
    font-weight: 800; font-size: 24px; letter-spacing: 0.5px; color: #7C3AED;
}
QLabel#appSubtitle {
    background-color: transparent;
    color: #9CA3AF; font-size: 11px; font-weight: 500;
}
QFrame#headerRule { background-color: #DCDEEA; border: none; }

/* The green here is Theme::pingOk() — #10B981 in both themes, because the ping rings and the power ring
   are painted from that one token and cannot follow a per-theme sheet colour. */
QWidget#statusDot { background-color: #10B981; border-radius: 3px; }
QWidget#statusDot[statusKind="stopped"]  { background-color: #9CA3AF; }
QWidget#statusDot[statusKind="starting"] { background-color: #D97706; }
QWidget#statusDot[statusKind="running"]  { background-color: #10B981; }
QWidget#statusDot[statusKind="error"]    { background-color: #DC2626; }
QLabel#statusText {
    background-color: transparent;
    color: #10B981; font-size: 12px; font-weight: 600; letter-spacing: 1px;
}
QLabel#statusText[statusKind="stopped"]  { color: #9CA3AF; }
QLabel#statusText[statusKind="starting"] { color: #D97706; }
QLabel#statusText[statusKind="running"]  { color: #059669; }
QLabel#statusText[statusKind="error"]    { color: #DC2626; }

/* ---------- route pill ---------- */
QPushButton#routePill {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #DCDEEA; border-radius: 999px;
    padding: 7px 16px; font-size: 12px; font-weight: 600;
}
QPushButton#routePill:hover { border-color: #7C3AED; color: #7C3AED; background-color: #F4EFFF; }
QPushButton#routePill:pressed { background-color: #EDE4FB; }
QPushButton#routePill:focus { outline: none; border-color: #DDD0F5; }

QPushButton#ghostButton {
    background-color: transparent; color: #6B7280;
    border: 1px solid #DCDEEA; border-radius: 10px;
    padding: 6px 12px; font-size: 10pt; font-weight: 500;
}
QPushButton#ghostButton:hover { background-color: #EDEEF5; border-color: #C9CCDC; color: #1F2937; }
QPushButton#ghostButton:pressed { background-color: #DCDFEB; }
QPushButton#ghostButton:focus { outline: none; }
QPushButton#ghostButton:disabled { color: #B4B8C6; border-color: #E2E4EF; }

/* ---------- pages ---------- */
QStackedWidget#pageStack { background-color: #F4F5FA; }
QWidget#dashboardPage, QWidget#strategiesPage, QWidget#logsPage { background-color: #F4F5FA; }
QLabel#pageTitle {
    background-color: transparent;
    font-size: 15pt; font-weight: 700; color: #111827;
}
QLabel#pageSubtitle {
    background-color: transparent;
    font-size: 9pt; color: #6B7280;
}

QFrame#card, StrategyCard, QFrame#strategyCard {
    background-color: #FFFFFF;
    border: 1px solid #DCDEEA;
    border-radius: 12px;
}
StrategyCard:hover, QFrame#strategyCard:hover { background-color: #F1F2FA; }
StrategyCard[active="true"], QFrame#strategyCard[active="true"] {
    border: 2px solid #7C3AED;
    background-color: #F4EFFF;
}
StrategyCard[error="true"], QFrame#strategyCard[error="true"] {
    border: 2px solid #DC2626;
    background-color: #FDF2F2;
}
QLabel#cardError      { color: #DC2626; font-size: 9pt; }
QLabel#cardTitle { font-size: 11pt; font-weight: 700; color: #111827; }
QLabel#cardDesc  { font-size: 9pt;  color: #6B7280; }
QLabel#cardHint  { font-size: 8pt;  color: #9CA3AF; }
QLabel#muted     { color: #6B7280; }
QLabel#placeholder { color: #9CA3AF; font-size: 11pt; }

QPushButton {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #C9CCDC; border-radius: 8px; padding: 7px 14px;
}
QPushButton:hover   { background-color: #F1F2FA; border-color: #AEB2C6; }
QPushButton:pressed { background-color: #E2E4EF; }
QPushButton:disabled { color: #B4B8C6; background-color: #EDEEF5; border-color: #EDEEF5; }
QPushButton#primaryButton {
    background-color: #7C3AED; color: #FFFFFF; border: 1px solid #7C3AED;
    border-radius: 8px; padding: 8px 16px; font-weight: 600;
}
QPushButton#primaryButton:hover   { background-color: #8B5CF6; border-color: #8B5CF6; }
QPushButton#primaryButton:pressed { background-color: #6D28D9; }
QPushButton#primaryButton:disabled { background-color: #C9BCEC; border-color: #C9BCEC; color: #F1ECFB; }
QPushButton#dangerButton { background-color: #FEE2E2; border-color: #FCA5A5; color: #B91C1C; }
QPushButton#dangerButton:hover { background-color: #FECACA; }
/* An id selector outranks a pseudo-state in QSS specificity, so QPushButton:disabled above does NOT
   reach this button: without this rule a greyed-out "Остановить" keeps its full live red and reads as
   clickable, which is precisely the misleading state during a teardown. Keep the neutral disabled
   tokens so it looks like every other unavailable control. */
QPushButton#dangerButton:disabled { background-color: #EDEEF5; border-color: #EDEEF5; color: #B4B8C6; }

QLineEdit, QSpinBox, QComboBox {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #C9CCDC; border-radius: 8px; padding: 6px 10px;
    selection-background-color: #7C3AED; selection-color: #FFFFFF;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #7C3AED; }
QLineEdit:read-only { color: #6B7280; background-color: #F3F4F8; }
QLineEdit#pathOk   { border: 1px solid #059669; }
QLineEdit#pathBad  { border: 1px solid #DC2626; }
QLabel#validOk  { color: #059669; font-size: 9pt; }
QLabel#validBad { color: #DC2626; font-size: 9pt; }
QLabel#trayNote { color: #B45309; font-size: 8pt; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right;
    width: 22px; border: none; }
QComboBox::down-arrow { image: url(:/icons/arrow-down.svg); width: 14px; height: 14px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #C9CCDC; border-radius: 8px; padding: 4px;
    selection-background-color: #7C3AED; selection-color: #FFFFFF; outline: none;
}
QSpinBox::up-button, QSpinBox::down-button { background: #EDEEF5; width: 16px; border: none; }
QSpinBox::up-arrow, QSpinBox::down-arrow { width: 10px; height: 10px; }

QCheckBox { spacing: 8px; color: #1F2937; background: transparent; }
QCheckBox::indicator {
    width: 16px; height: 16px; border-radius: 5px;
    border: 1px solid #AEB2C6; background-color: #FFFFFF;
}
QCheckBox::indicator:hover  { border-color: #7C3AED; }
QCheckBox::indicator:checked { background-color: #7C3AED; border-color: #7C3AED;
    image: url(:/icons/check.svg); }

QPlainTextEdit#logView {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #DCDEEA; border-radius: 10px;
    font-family: "JetBrains Mono", "Cascadia Mono", "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 9pt; padding: 6px;
}
QFrame#logPanel { background-color: #FFFFFF; border: 1px solid #DCDEEA; border-radius: 12px; }
QFrame#logHeader { background: transparent; border: none; }

QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #C7CAD9; border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #AEB2C6; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal { background: #C7CAD9; border-radius: 4px; min-width: 28px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: none; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---------- footer + ping badges ---------- */
QFrame#footerBar { background-color: #F4F5FA; border-top: 1px solid #DCDEEA; }
QLabel#footerHint { background-color: transparent; color: #9CA3AF; font-size: 11px; }
QLabel#dirLabel { background-color: transparent; color: #B4B8C6; font-size: 11px; }
QLabel#pingNumber { background-color: transparent; color: #111827; font-size: 12px; font-weight: 700; }
QLabel#pingClock  { background-color: transparent; }
QLabel#pingLabel  { background-color: transparent; color: #9CA3AF; font-size: 10px; }

QMenu {
    background-color: #FFFFFF; color: #1F2937;
    border: 1px solid #C9CCDC; border-radius: 10px; padding: 6px;
}
QMenu::item { padding: 6px 22px 6px 14px; border-radius: 6px; }
QMenu::item:selected { background-color: #7C3AED; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #E2E4EF; margin: 5px 8px; }

QSplitter::handle { background-color: #E2E4EF; width: 3px; }
QGroupBox { border: 1px solid #DCDEEA; border-radius: 10px; margin-top: 12px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; color: #6B7280; }
QHeaderView::section { background-color: #EDEEF5; color: #6B7280; border: none; padding: 6px; }
QDialogButtonBox QPushButton { min-width: 84px; }
QProgressBar { border: 1px solid #DCDEEA; border-radius: 6px; background: #F3F4F8; color: #1F2937; }
QProgressBar::chunk { background-color: #0891B2; border-radius: 5px; }

/* ---------- window surfaces (keep this block last) ---------------------------
   Same cascade trap as the dark sheet: the generic transparent QWidget rule outranks the window rule at
   the top of the file, so anything with nothing behind it (the window itself, the stacked widget, the
   card list's viewport) painted black instead of the light background. */
QMainWindow, QDialog, QStackedWidget, QStackedWidget#pageStack, QSplitter, QScrollArea,
QScrollArea > QWidget > QWidget, QWidget#rootCanvas, QWidget#cardHost, QWidget#logPanel,
QWidget#logHeader, QWidget#dashboardPage, QWidget#strategiesPage, QWidget#logsPage,
QWidget#placeholderPage, QWidget#headerBar {
    background-color: #F4F5FA;
}
QFrame#sidebar { background-color: #E9EBF3; }
QFrame#mainArea, QFrame#footerBar { background-color: #F4F5FA; }
