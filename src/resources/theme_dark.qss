/* ============================================================================
   Muffin — dark theme, "minimalist cyberpunk dashboard".

   Tokens (mirrored by Theme.cpp::tokensFor(true) — change both, they are one palette):
     bg #0B0C10   surface #15161C   recessed #090A0D   hover #1F222D
     hairline #1F2833   border #262A36   edge #343A4A   text #E7E9F2   muted #8A91A6   faint #5A6175
     accent #C084FC (hover #D8B4FE, pressed #A855F7, tint #1C1727)   accent2 #22D3EE
     ok #34D399   neon green #10B981 (Theme::pingOk: the connected chip, live ping rings)
     neon grey #9CA3AF (Theme::pingMuted: a ping badge's label and clock)
     err #F87171   warn #FBBF24

   Shape: a 70 px rail of glyphs on the left; to its right one column that is header, one full-width
   page at a time, and a hairline footer. Rules are grouped in that order — shell, header, pages,
   tool buttons, cards, buttons, inputs, log, footer, ping badges, chrome.

   The circles are not styled here: PowerButton and PingIndicator paint their own rims and halos,
   because a stylesheet cannot clip a glow to a circle. The hexes they paint with are the ones listed
   above, so a sheet change without the matching Theme.cpp change shows up as two greens.

   Every object name below is a contract with the C++ side (setObjectName in MainWindow / LogPanel /
   ProfileCard / SettingsPage / PingIndicator), and several are asserted by tests/uitest.cpp —
   renaming one silently unstyles the widget it targets.
   ==========================================================================*/

QMainWindow, QDialog { background-color: #0B0C10; }

QWidget {
    background-color: transparent;
    color: #E7E9F2;
    font-family: "Inter", "Segoe UI", "Noto Sans", "Cantarell", sans-serif;
    font-size: 10pt;
}
QToolTip {
    background-color: #15161C; color: #E7E9F2;
    border: 1px solid #262A36; padding: 6px 9px; border-radius: 8px;
}

/* ---------- shell: rail + main area -------------------------------------------
   Two columns, edge to edge, one hairline between them. The rail is 70 px of glyphs with no labels
   anywhere; everything that carries text lives to its right. */
QFrame#sidebar {
    background-color: #0B0C10;
    border-right: 1px solid #1F2833;
}
QFrame#mainArea { background-color: #0B0C10; }
QLabel#brandLogo { background-color: transparent; }

/* One rule for every rail glyph. They are icon-only QPushButtons — the accessible name and the tooltip
   are set in C++, so the sheet's whole job is to make the button vanish apart from its icon.

   The same rounded plate appears under hover, under the pointer while pressed, and under whichever glyph
   owns the page on screen: one shape, #1F2833, 8 px of radius, so journal and settings read as peers of
   each other instead of one of them being the only control that ever answers the pointer. */
QPushButton#navButton {
    background-color: transparent; color: #9CA3AF;
    border: 1px solid transparent; border-radius: 8px; padding: 0;
}
QPushButton#navButton:hover {
    background-color: #1F2833; border-color: #1F2833; color: #E7E9F2;
}
QPushButton#navButton:pressed { background-color: #1F2833; border-color: #2A3644; }
QPushButton#navButton:checked { background-color: #1F2833; border-color: #2E2545; color: #C084FC; }
QPushButton#navButton:focus { outline: none; border-color: #2E2545; }
QPushButton#navButton:disabled { color: #454A5C; background-color: transparent; }

/* The language picker is the rail's one QToolButton: a flag instead of a glyph, and the same plate so
   it belongs to the group above it. Its icon is colour artwork and must not be flattened, hence no
   border/text tricks beyond the hover plate. */
QToolButton#langButton {
    background-color: transparent; border: 1px solid transparent; border-radius: 8px;
    padding: 0;
}
QToolButton#langButton:hover { background-color: #1F2833; border-color: #1F2833; }
QToolButton#langButton:pressed { background-color: #1F2833; border-color: #2A3644; }
QToolButton#langButton:focus { outline: none; border-color: #2E2545; }
/* The journal's glyph while the page it opens is hidden: a new warning or error went unnoticed. The glyph
   itself is a baked pixmap and cannot recolour itself, so the alert lives on the button's frame. */
QPushButton#navButton[alert="true"] { color: #F87171; border-color: #4B2530; background-color: #1B1215; }

QLabel#railVersion {
    background-color: transparent;
    color: #5A6175; font-size: 10px; font-weight: 500; letter-spacing: 0.3px;
}

/* ---------- window chrome (frameless) ----------------------------------------
   The window carries no system frame, so its two controls live in the header. They are icon-only
   QToolButtons that carry a "glyph" property (so applyTheme() re-bakes them like every other baked
   icon) and a "role" property that separates the destructive one: the close button turns to the failure
   red on hover so "leave" reads differently from "tuck away", while minimise keeps the neutral plate. */
QToolButton#windowButton {
    background-color: transparent; color: #9CA3AF;
    border: 1px solid transparent; border-radius: 8px; padding: 0;
}
QToolButton#windowButton:hover { background-color: #1F2833; border-color: #1F2833; color: #E7E9F2; }
QToolButton#windowButton:pressed { background-color: #1F2833; border-color: #2A3644; }
QToolButton#windowButton:focus { outline: none; border-color: #2E2545; }
QToolButton#windowButton[role="close"]:hover { background-color: #F87171; border-color: #F87171; color: #0B0C10; }
QToolButton#windowButton[role="close"]:pressed { background-color: #E05B5B; border-color: #E05B5B; }

/* ---------- header ---------- */
QWidget#headerBar { background-color: #0B0C10; }
QLabel#appTitle {
    background-color: transparent;
    font-family: "Montserrat", "Outfit", "Inter", "Segoe UI", sans-serif;
    font-weight: 800; font-size: 24px; letter-spacing: 0.5px; color: #C084FC;
}
QFrame#headerRule { background-color: #1F2833; border: none; }

/* The dot and its word read the same statusKind property, so the pair can never disagree about whether
   this is a connected machine. Green #10B981 is Theme::pingOk() — change one, change the other. */
QWidget#statusDot { background-color: #10B981; border-radius: 3px; }
QWidget#statusDot[statusKind="stopped"]  { background-color: #5A6175; }
QWidget#statusDot[statusKind="starting"] { background-color: #FBBF24; }
QWidget#statusDot[statusKind="running"]  { background-color: #10B981; }
QWidget#statusDot[statusKind="error"]    { background-color: #F87171; }
QLabel#statusText {
    background-color: transparent;
    color: #10B981; font-size: 12px; font-weight: 600; letter-spacing: 1px;
}
QLabel#statusText[statusKind="stopped"]  { color: #5A6175; }
QLabel#statusText[statusKind="starting"] { color: #FBBF24; }
QLabel#statusText[statusKind="running"]  { color: #10B981; }
QLabel#statusText[statusKind="error"]    { color: #F87171; }

QPushButton#ghostButton {
    background-color: transparent; color: #8A91A6;
    border: 1px solid #262A36; border-radius: 10px;
    padding: 6px 12px; font-size: 10pt; font-weight: 500;
}
QPushButton#ghostButton:hover { background-color: #1F222D; border-color: #343A4A; color: #E7E9F2; }
QPushButton#ghostButton:pressed { background-color: #15161C; }
QPushButton#ghostButton:focus { outline: none; }
QPushButton#ghostButton:disabled { color: #454A5C; border-color: #1F2230; }

/* ---------- pages ---------- */
QStackedWidget#pageStack { background-color: #0B0C10; }
QWidget#dashboardPage, QWidget#profilesPage, QWidget#logsPage { background-color: #0B0C10; }
QWidget#settingsPageHost, QWidget#settingsPage { background-color: #0B0C10; }
QLabel#pageTitle {
    background-color: transparent;
    font-size: 15pt; font-weight: 700; color: #E7E9F2;
}
QLabel#pageSubtitle {
    background-color: transparent;
    font-size: 9pt; color: #8A91A6;
}
/* ---------- tool buttons ---------- */
/* The main window has no toolbar any more; these survive for the tool buttons a native file dialog or a
   QComboBox can still put on screen. */
QToolBar, QToolBar::separator { background-color: #0B0C10; border: none; spacing: 6px; }
QToolButton {
    background-color: transparent; color: #B8BED0;
    border: 1px solid transparent; border-radius: 9px; padding: 6px 11px;
    font-size: 9pt; font-weight: 500;
}
QToolButton:hover  { background-color: #1F222D; border-color: #262A36; color: #E7E9F2; }
QToolButton:pressed { background-color: #15161C; }
QToolButton:disabled { color: #454A5C; background-color: transparent; border-color: transparent; }

/* ---------- profile rows ----------
   One horizontal row per profile: the name at the left, the mini ping chips in the middle, the row menu
   at the right. A row is a choice, not a control — starting belongs to the dashboard's power button — so
   the only interactive states are the two the window paints with dynamic properties: the neon edge says
   "this is the profile the button will run", the red edge says "this one failed" and moves the reason to
   the tooltip. Because QSS never re-reads a property on its own, ProfileCard unpolishes/repolishes on
   every change, exactly as the rail's [alert] tab does. */
QFrame#profileCard {
    background-color: #15161C;
    border: 1px solid #262A36;
    border-radius: 12px;
}
QFrame#profileCard:hover { background-color: #191C24; border: 1px solid #343A4A; }
QFrame#profileCard[selected="true"] {
    border: 1px solid #C084FC;
    background-color: #17131F;
}
QFrame#profileCard[selected="true"]:hover { background-color: #1C1727; }
QFrame#profileCard[error="true"] {
    border: 1px solid #F87171;
    background-color: #1B1215;
}
QLabel#profileName {
    background-color: transparent; color: #E7E9F2; font-size: 11pt; font-weight: 600;
}
QWidget#profilePings { background-color: transparent; border: none; }
/* A chip is one service's mark and its latency, set on a faint recessed plate so the pair reads as a unit
   rather than as two loose labels on the row. The glyph and its colour are baked by ProfileCard from
   PingIndicator::dotColor(), so only the number's text lives here. */
QWidget#miniPing {
    background-color: #0F1116; border: 1px solid #262A36; border-radius: 7px;
}
QLabel#miniPingIcon { background-color: transparent; }
QLabel#miniPingValue {
    background-color: transparent; color: #9CA3AF; font-size: 10px; font-weight: 600;
}
QLabel#muted { color: #8A91A6; background: transparent; }
QLabel#placeholder { color: #5A6175; font-size: 11pt; background: transparent; }

/* The row's menu button: a 30x30 plate holding the three-dot glyph, quiet until the pointer arrives, and
   the same rounded popup as every other QMenu in the app. */
QToolButton#cardMenu {
    background-color: transparent; border: 1px solid transparent; border-radius: 8px; padding: 0;
}
QToolButton#cardMenu:hover { background-color: #1F222D; border-color: #262A36; }
QToolButton#cardMenu:pressed { background-color: #15161C; }
QToolButton#cardMenu:focus { outline: none; }
QMenu#cardMenuPopup { min-width: 148px; }

/* ---------- buttons ---------- */
QPushButton {
    background-color: #1F222D; color: #E7E9F2;
    border: 1px solid #2A2E3B; border-radius: 9px; padding: 7px 14px;
    font-size: 9pt; font-weight: 500;
}
QPushButton:hover   { background-color: #262A36; border-color: #343A4A; }
QPushButton:pressed { background-color: #15161C; }
QPushButton:disabled { color: #454A5C; background-color: #15161C; border-color: #1A1D26; }
QPushButton:focus   { outline: none; }
/* The neon pair: purple carries "this starts something", and the ink is the app background because
   #C084FC is light enough that white-on-purple fails contrast. */
QPushButton#primaryButton {
    background-color: #C084FC; color: #0B0C10; border: 1px solid #C084FC;
    border-radius: 9px; padding: 8px 18px; font-weight: 700; font-size: 9pt;
}
QPushButton#primaryButton:hover   { background-color: #D8B4FE; border-color: #D8B4FE; }
QPushButton#primaryButton:pressed { background-color: #A855F7; border-color: #A855F7; }
QPushButton#primaryButton:disabled { background-color: #241F31; border-color: #2E2545; color: #5A5470; }
QPushButton#dangerButton {
    background-color: transparent; border: 1px solid #4B2530; color: #F87171;
    font-weight: 600;
}
QPushButton#dangerButton:hover { background-color: #2A1418; border-color: #F87171; }
QPushButton#dangerButton:pressed { background-color: #221418; }
/* An id selector outranks a pseudo-state in QSS specificity, so QPushButton:disabled above does NOT
   reach this button: without this rule a greyed-out "Остановить" keeps its full live red and reads as
   clickable, which is precisely the misleading state during a teardown. Keep the neutral disabled
   tokens so it looks like every other unavailable control. */
QPushButton#dangerButton:disabled { background-color: #15161C; border-color: #1A1D26; color: #454A5C; }
/* ---------- inputs ---------- */
QLineEdit, QSpinBox, QComboBox {
    background-color: #0F1116; color: #E7E9F2;
    border: 1px solid #262A36; border-radius: 9px; padding: 6px 10px;
    selection-background-color: #C084FC; selection-color: #0B0C10;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #C084FC; }
QLineEdit:read-only { color: #8A91A6; }
QLineEdit#pathOk   { border: 1px solid #34D399; }
QLineEdit#pathBad  { border: 1px solid #F87171; }
QLabel#validOk  { color: #34D399; font-size: 9pt; }
QLabel#validBad { color: #F87171; font-size: 9pt; }
/* "Minimize to tray" that this desktop cannot honour — a warning, not an error. */
QLabel#trayNote { color: #FBBF24; font-size: 8pt; }
/* The Save button's acknowledgement. Green rather than the accent because it reports an outcome, not an
   action — the same #34D399 the sheet uses for any "it worked", and it sits beside the primary button
   without competing with it for attention. */
QLabel#savedNote { color: #34D399; font-size: 10pt; font-weight: 600; background: transparent; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right;
    width: 22px; border: none; }
QComboBox::down-arrow { image: url(:/icons/arrow-down.svg); width: 14px; height: 14px; }
QComboBox QAbstractItemView {
    background-color: #15161C; color: #E7E9F2;
    border: 1px solid #262A36; border-radius: 9px; padding: 4px;
    selection-background-color: #1C1727; selection-color: #C084FC; outline: none;
}
QSpinBox::up-button, QSpinBox::down-button { background: #1F222D; width: 16px; border: none; }
QSpinBox::up-arrow, QSpinBox::down-arrow { width: 10px; height: 10px; }

QCheckBox { spacing: 8px; color: #E7E9F2; background: transparent; }
QCheckBox::indicator {
    width: 16px; height: 16px; border-radius: 5px;
    border: 1px solid #343A4A; background-color: #0F1116;
}
QCheckBox::indicator:hover  { border-color: #C084FC; }
QCheckBox::indicator:checked { background-color: #C084FC; border-color: #C084FC;
    image: url(:/icons/check.svg); }

/* ---------- log ---------- */
/* The well is darker than the page so the journal reads as a console sunk into the dashboard, and
   the mono stack is what makes a column of timestamps line up. */
QPlainTextEdit#logView {
    background-color: #090A0D; color: #E7E9F2;
    border: 1px solid #262A36; border-radius: 12px;
    font-family: "JetBrains Mono", "Cascadia Mono", "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 9pt; padding: 8px;
}
QFrame#logPanel { background-color: #12131A; border: 1px solid #262A36; border-radius: 14px; }
QFrame#logHeader { background: transparent; border: none; }

/* ---------- scroll ---------- */
QScrollArea, QScrollArea#cardScroll { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 2px; }
QScrollBar::handle:vertical { background: #262A36; border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #C084FC; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 2px; }
QScrollBar::handle:horizontal { background: #262A36; border-radius: 4px; min-width: 28px; }
QScrollBar::handle:horizontal:hover { background: #C084FC; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: none; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
/* ---------- footer ---------- */
/* The thin strip the status bar became. It carries the resolved zapret path on the left and the ping
   cadence in the middle, and it is also where a transient sentence appears — see showTransientMessage(). */
QFrame#footerBar { background-color: #0B0C10; border-top: 1px solid #1F2833; }
QLabel#footerHint { background-color: transparent; color: #5A6175; font-size: 11px; }

/* ---------- ping badges ----------
   The ring, its halo and the glyph inside it are painted by PingIndicator; the sheet owns only the two
   labels that frame it. #10B981/#9CA3AF are the values Theme::pingOk()/Theme::pingMuted() paint with. */
QLabel#pingNumber { background-color: transparent; color: #FFFFFF; font-size: 12px; font-weight: 700; }
QLabel#pingClock  { background-color: transparent; }
QLabel#pingLabel  { background-color: transparent; color: #9CA3AF; font-size: 10px; }

/* ---------- menus ---------- */
QMenu {
    background-color: #15161C; color: #E7E9F2;
    border: 1px solid #262A36; border-radius: 12px; padding: 6px;
}
QMenu::item { padding: 7px 24px 7px 14px; border-radius: 8px; }
QMenu::item:selected { background-color: #1C1727; color: #C084FC; }
QMenu::item:disabled { color: #454A5C; }
QMenu::separator { height: 1px; background: #262A36; margin: 6px 8px; }

/* ---------- misc ---------- */
/* Splitter rules survive for the layouts that still use one; the main window does not, having moved
   to a rail plus a page stack. */
QSplitter::handle { background-color: #15161C; width: 3px; }
QGroupBox { border: 1px solid #262A36; border-radius: 12px; margin-top: 12px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; color: #8A91A6; }
QHeaderView::section { background-color: #15161C; color: #8A91A6; border: none; padding: 6px; }
QDialogButtonBox QPushButton { min-width: 88px; }
QProgressBar {
    border: 1px solid #262A36; border-radius: 8px; background: #0F1116; color: #E7E9F2;
    text-align: center;
}
/* The one cyan surface in the app: an indeterminate download reads as energy moving, not as a second
   primary button. */
QProgressBar::chunk { background-color: #22D3EE; border-radius: 7px; }

/* ---------- window surfaces (keep this block last) ---------------------------
   The generic `QWidget { background-color: transparent }` near the top is what lets cards, rows and
   labels composite over their parents. It has the same specificity as a plain type rule, and in Qt's
   stylesheet cascade the last match wins — so a top-level window, a stacked widget or a scroll
   viewport left transparent composites onto *black*. Invisible in the dark theme, glaring in the light
   one, so every surface meant to carry the app background is re-asserted here, after all generic
   rules. The rail and the main area are id rules like these and must not lose the tie to the block
   above; the header and footer are transparent-by-inheritance and must not gain one. */
QMainWindow, QDialog, QStackedWidget, QStackedWidget#pageStack, QSplitter,
QScrollArea, QScrollArea > QWidget > QWidget,
QWidget#rootCanvas, QWidget#cardHost, QWidget#logPanel, QWidget#logHeader,
QWidget#dashboardPage, QWidget#profilesPage, QWidget#logsPage, QWidget#placeholderPage,
QWidget#settingsPageHost, QWidget#settingsPage,
QWidget#headerBar {
    background-color: #0B0C10;
}
QFrame#sidebar, QFrame#mainArea { background-color: #0B0C10; }
QFrame#footerBar { background-color: #0B0C10; }



